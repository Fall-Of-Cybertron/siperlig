# ==========================================================
# Highlightly Football API Yapılandırması
# Bu dosyayı kopyalayıp backend/.env olarak kullanın.
# ASLA gerçek API anahtarlarınızı Git'e veya sohbete yapıştırmayın!
# ==========================================================

# 1) API Platform Seçimi:
# Highlightly sitesinden doğrudan aldıysanız:
HIGHLIGHTLY_BASE_URL=https://sports.highlightly.net/football
# RapidAPI üzerinden aldıysanız yukarıdakini yorum yapıp şunu açın:
# HIGHLIGHTLY_BASE_URL=https://football-highlights-api.p.rapidapi.com
# HIGHLIGHTLY_RAPIDAPI_HOST=football-highlights-api.p.rapidapi.com

# Kimlik doğrulama başlığı:
# Highlightly doğrudan panelde genelde "x-rapidapi-key" veya "bearer" veya "x-api-key" kullanılır.
HIGHLIGHTLY_AUTH_MODE=x-rapidapi-key

# 2) Çoklu API Anahtarları (Arkadaş grubunuzun anahtarları)
# Her biri günlük 100 istek limitli anahtarları alt alta ekleyebilirsiniz:
HIGHLIGHTLY_API_KEY_1=buraya_1_anahtari_yapistir
HIGHLIGHTLY_API_KEY_2=buraya_2_anahtari_yapistir
HIGHLIGHTLY_API_KEY_3=buraya_3_anahtari_yapistir
# İsterseniz virgülle ayırarak da yazabilirsiniz:
# HIGHLIGHTLY_API_KEYS=anahtar1,anahtar2,anahtar3

# 3) Kota Koruma Ayarları
DAILY_LIMIT_PER_KEY=100
SAFE_LIMIT_PER_KEY=95
DEFAULT_RUN_BUDGET=15

# Süper Lig Kimliği (Otomatik keşif için boş bırakabilir veya bulunca yazabilirsiniz)
SUPER_LIG_SEASON=2026
SUPER_LIG_COUNTRY=Turkey
SUPER_LIG_LEAGUE_NAME=Süper Lig
